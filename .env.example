# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
# Choose one provider. Gemini is supported through its OpenAI-compatible API.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
